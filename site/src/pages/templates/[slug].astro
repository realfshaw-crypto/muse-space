---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../../../templates.json';
export function getStaticPaths() {
  return data.templates.map((t) => ({ params: { slug: t.slug }, props: { t } }));
}
const { t } = Astro.props;
const siteUrl = 'https://realfshaw-crypto.github.io/muse-space/';
const pageUrl = siteUrl + 'templates/' + t.slug + '/';
const previewHref = '../../templates/' + t.slug + '/index.html';
const features = [
  t.description_en,
  'Built around: ' + t.keywords_en.join(', ') + ' (' + t.keywords_zh.join('、') + ').',
  'Single-file HTML: open instantly, no install and no build step.',
  'Your data stays local: saved in browser localStorage only.',
  'Astryx design tokens, automatic light and dark, bilingual UI text (English and Chinese).',
];
const appLd = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: t.name_en + ' — ' + t.name_zh + ' | Muse Space', url: pageUrl, applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web browser', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: t.description_en, inLanguage: ['en', 'zh-CN'], isPartOf: { '@type': 'WebSite', name: 'Muse Space', url: siteUrl } };
---
<BaseLayout title={t.name_en + ' (' + t.name_zh + ') — Muse Space Template'} description={t.description_en + ' ' + t.description_zh + ' A free Muse Space mini-app template: say one sentence to Muse and use it instantly.'} canonical={pageUrl} jsonLd={[appLd]}>
  <div class="wrap"><article class="detail">
    <p><a href="../../">← All templates / 全部模板</a></p>
    <p class="muted">{t.category}</p>
    <h1>{t.name_en} — {t.name_zh}</h1>
    <p><strong>{t.description_en}</strong></p>
    <p>{t.description_zh}</p>

    <h2>Question &amp; answer / 问答摘要</h2>
    <div class="qa">
      <p><strong>What is {t.name_en}?</strong> {t.description_en} It is one of the 25 Muse Space templates, in the {t.category} category.</p>
      <p><strong>{t.name_zh}是什么？</strong>{t.description_zh}它是 Muse Space 的 25 个模板之一，分类为 {t.category}。</p>
      <p><strong>How do I use it?</strong> Ask Muse for it in one sentence (examples below). Muse loads this template, fills in your data, and generates a ready-to-use Space. Your data is stored locally in localStorage.</p>
    </div>

    <h2>Core features / 核心功能</h2>
    <ul>{features.map((f) => (<li>{f}</li>))}</ul>

    <h2>How to ask Muse / 如何对 Muse 说</h2>
    <p>Say one sentence, in English or Chinese:</p>
    <p class="say">"Open {t.name_en}" · "Give me a {t.name_en}" · 「打开{t.name_zh}」 · 「给我一个{t.name_zh}」</p>
    <p>Muse reads templates.json, finds the template with slug <strong>{t.slug}</strong>, and creates your Space from it.</p>

    <h2>Open the template / 打开模板预览</h2>
    <p>In the GitHub repository, this template is a single HTML file at <strong>templates/{t.slug}/index.html</strong>. From this detail page, the repository-relative preview link is:</p>
    <p><a class="btn" href={previewHref}>Open template preview / 打开模板预览</a></p>
    <p>That link uses the relative path <strong>../../templates/{t.slug}/index.html</strong>, which resolves to the template file when you browse the repository or a full local checkout. On this preview site alone it points outside the site root, so for the live file use the repository: <a href={'https://github.com/realfshaw-crypto/muse-space/blob/main/templates/' + t.slug + '/index.html'}>view {t.slug}/index.html on GitHub</a>.</p>

    <h2>Related terms / 相关说法</h2>
    <p>{t.keywords_en.join(', ')}</p>
    <p>{t.keywords_zh.join('、')}</p>
  </article></div>
</BaseLayout>
